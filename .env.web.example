# Copy to .env.web and change the password and public URL before `docker compose up`.
# Never commit .env.web.

# Required: at least 8 characters. Prefer a long random passphrase.
TAYANG_WEB_PASSWORD=change-me-to-a-long-random-password

# Or use a pre-hashed argon2id PHC string instead of the plaintext password:
#   docker compose run --rm --entrypoint tayang-server -e TAYANG_WEB_PASSWORD='...' tayang hash-password
# TAYANG_WEB_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...

# The exact origin users open in the browser. Used for origin checks and Secure cookies.
TAYANG_PUBLIC_URL=https://studio.example.com

# Listen inside the container. The host port is set in .env (Compose variable), not here.
TAYANG_BIND=0.0.0.0:8787

# Persistent state. In Docker this is the /data volume.
TAYANG_DATA_DIR=/data
TAYANG_WORKSPACE_ROOT=/data/workspaces
TAYANG_DIST_DIR=/app/dist
TAYANG_AGENT_PLUGIN_DIR=/app/agent-plugin

# HTTPS behind a reverse proxy: keep cookies Secure and trust the proxy's forwarded client IP.
TAYANG_COOKIE_SECURE=true
TAYANG_TRUST_PROXY=true

# Session lifetime and upload ceiling.
TAYANG_SESSION_HOURS=720
TAYANG_MAX_UPLOAD_MB=50

# Scheduler/autopilot clock.
TAYANG_TICK_SECS=30

# Optional: point built-in style sync at another compatible API base.
# TAYANG_API_URL=https://studio.tayang.app/api

RUST_LOG=info,tower_http=warn
