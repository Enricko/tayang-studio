{
  "name": "tayang-studio",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:desktop": "pnpm --filter @tayang/desktop tauri dev --config src-tauri/tauri.dev.conf.json",
    "version:set": "node scripts/version.mjs",
    "usage": "node scripts/usage-report.mjs",
    "dev:web": "pnpm --filter @tayang/desktop dev:web",
    "build:web": "pnpm --filter @tayang/desktop build:web",
    "server:dev": "cargo run -p tayang-server",
    "server": "cargo run --release -p tayang-server",
    "web:import-agent-auth": "bash scripts/web-import-agent-auth.sh"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4"
  }
}
